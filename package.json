{
  "name": "pickyour-ai",
  "private": true,
  "version": "0.1.0",
  "description": "PickYour.AI — a PCPartPicker-style AI stack builder (static SPA).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4317 --strictPort",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b --noEmit",
    "contracts:verify": "node scripts/contracts.mjs verify",
    "contracts:update": "node scripts/contracts.mjs update",
    "contracts:types": "node scripts/generate-contract-types.mjs",
    "test": "node --test scripts/deploy/live-admission.test.mjs && vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit": "npm audit --omit=dev --audit-level=high",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:lighthouse": "node --test scripts/lighthouse-budget.test.mjs && node scripts/lighthouse.mjs",
    "fonts:subset": "node scripts/subset-fonts.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "chrome-launcher": "1.2.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fontverter": "2.0.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "json-schema-to-typescript": "16.0.0",
    "lighthouse": "13.5.0",
    "prettier": "3.9.10",
    "subset-font": "2.9.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
