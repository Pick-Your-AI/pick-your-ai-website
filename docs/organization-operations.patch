diff --git b/.github/workflows/organization-update-proposal.yml b/.github/workflows/organization-update-proposal.yml
new file mode 100644
index 0000000..ccd24e8
--- /dev/null
+++ b/.github/workflows/organization-update-proposal.yml
@@ -0,0 +1,163 @@
+name: Propose organization directory update
+
+# STATUS: PREPARED FOR THE OPERATIONS OWNER. NOT ENABLED. IT CANNOT PUBLISH ANYTHING AUTOMATICALLY TODAY.
+#
+# This is a proposal for one narrow, manual-dispatch route from a merged Pick-Your-AI/.github organization
+# bundle to a pull request here (docs/ORGANIZATION_DIRECTORY.md). It does not make end-to-end publication
+# automatic and must not be described that way. The currently available proposal route is the importer run
+# locally by an authorized human (`npm run organization:update`).
+#
+# MISSING OWNER GATES (nothing here enables, bypasses or requests them):
+#   1. A writer. This repository's Actions setting for creating pull requests is off
+#      (can_approve_pull_request_reviews=false), so the workflow token cannot open the PR, and a PR opened with
+#      GITHUB_TOKEN would not start CI. A separate, narrowly scoped publication identity, authorized by the
+#      owners, is the alternative. The .github collector App must never receive write access here.
+#   2. Branch rules. The contributor-boundary rules exclude contrib/* and apply to feat/* branches, so the
+#      branch is contrib/github-actions/organization-<sha12>. Owners must confirm that a workflow-created
+#      branch under that name is acceptable.
+#   3. Enabling. The job is skipped unless the repository variable ORGANIZATION_PROPOSAL_ENABLED is 'true',
+#      which only the owners set once 1 and 2 are settled.
+#
+# Properties: manual `workflow_dispatch` only; runs the importer from this repository's own main; the fetched
+# .github commit is data (hash-checked, validated, never executed; no automation branch is followed; the
+# upstream host is fixed in the importer); the commit must be merged into .github main and the claimed
+# human review is checked against the API; one verified branch and one PR are reused, a failed earlier run
+# is recovered (the PR is created if only the push succeeded), and unrelated work on the branch is never
+# overwritten. It never merges, approves or deploys. The merge here is the website source-pin approval.
+on:
+  workflow_dispatch:
+    inputs:
+      ref:
+        description: Full 40-character commit SHA on Pick-Your-AI/.github main
+        required: true
+        type: string
+      pull_request:
+        description: Number of the merged Pick-Your-AI/.github pull request
+        required: true
+        type: string
+      review_id:
+        description: ID of the approving independent human review on that pull request
+        required: true
+        type: string
+
+permissions:
+  contents: read
+
+concurrency:
+  group: organization-update
+  cancel-in-progress: false
+
+jobs:
+  propose:
+    name: validate and propose
+    if: github.ref == 'refs/heads/main' && vars.ORGANIZATION_PROPOSAL_ENABLED == 'true'
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    permissions:
+      contents: write
+      pull-requests: write
+    env:
+      REF: ${{ inputs.ref }}
+      PR: ${{ inputs.pull_request }}
+      REVIEW_ID: ${{ inputs.review_id }}
+      GH_TOKEN: ${{ github.token }}
+    steps:
+      - name: Check inputs
+        run: |
+          [[ "$REF" =~ ^[0-9a-f]{40}$ ]] || { echo "ref must be a full 40-char lowercase sha"; exit 1; }
+          [[ "$PR" =~ ^[0-9]{1,6}$ ]] || { echo "pull_request must be a number"; exit 1; }
+          [[ "$REVIEW_ID" =~ ^[0-9]{1,15}$ ]] || { echo "review_id must be a number"; exit 1; }
+
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          ref: ${{ github.sha }}
+          fetch-depth: 0
+
+      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
+        with:
+          node-version: '22'
+          cache: npm
+
+      # Dependency lifecycle scripts are not needed to run the importer.
+      - run: npm ci --ignore-scripts
+
+      - name: Check the merge and the human approval claimed for this commit
+        id: claims
+        run: |
+          api() { gh api -H 'Accept: application/vnd.github+json' "$@"; }
+          pr="$(api "repos/Pick-Your-AI/.github/pulls/$PR")"
+          review="$(api "repos/Pick-Your-AI/.github/pulls/$PR/reviews/$REVIEW_ID")"
+          # No pipe into tee: the default step shell has no pipefail, which would mask a failed check.
+          reviewer="$(node --input-type=module -e '
+            const [pr, review] = [process.argv[1], process.argv[2]].map((s) => JSON.parse(s));
+            const ref = process.env.REF;
+            const problems = [];
+            if (!pr.merged) problems.push("pull request is not merged");
+            if (pr.base?.ref !== "main") problems.push("pull request did not merge into main");
+            if (review.state !== "APPROVED") problems.push(`review state is ${review.state}`);
+            if (review.user?.type !== "User") problems.push("reviewer is not a human user account");
+            if (review.user?.login === pr.user?.login) problems.push("reviewer is the pull request author");
+            if (review.commit_id !== pr.head?.sha) problems.push("approval is not on the pull request final head");
+            if (pr.merge_commit_sha !== ref && pr.head?.sha !== ref)
+              problems.push("commit is neither the final head nor the merge commit of that pull request");
+            if (!/^[A-Za-z0-9-]{1,39}$/.test(review.user?.login ?? "")) problems.push("unexpected reviewer login");
+            if (problems.length) { console.error(problems.join("\n")); process.exit(1); }
+            console.log(review.user.login);
+          ' "$pr" "$review")"
+          echo "reviewer=$reviewer" >> "$GITHUB_OUTPUT"
+
+      - name: Import (fixed upstream, exact SHA, ancestor of main)
+        env:
+          REVIEWER: ${{ steps.claims.outputs.reviewer }}
+        run: |
+          node scripts/organization.mjs update --ref "$REF" \
+            --pull-request "https://github.com/Pick-Your-AI/.github/pull/$PR" \
+            --review-url "https://github.com/Pick-Your-AI/.github/pull/$PR#pullrequestreview-$REVIEW_ID" \
+            --reviewer "$REVIEWER"
+          npm run organization:verify
+
+      - name: Reconcile the branch and pull request (reuse one, recover a partial run)
+        run: |
+          if git diff --quiet origin/main -- public/organization contracts/organization \
+             && [ -z "$(git ls-files --others --exclude-standard -- public/organization contracts/organization)" ]; then
+            echo "This commit is already admitted on main; nothing to propose." | tee -a "$GITHUB_STEP_SUMMARY"
+            exit 0
+          fi
+          branch="contrib/github-actions/organization-${REF:0:12}"
+          git config user.name "github-actions[bot]"
+          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
+          # Commit locally so the verified result can be compared with any existing remote branch.
+          git switch -c proposal-local
+          git add public/organization contracts/organization/PIN.json
+          git commit -q -m "feat: admit organization directory bundle ${REF:0:12}" \
+            -m "Source: Pick-Your-AI/.github@$REF (merged in pull request $PR). Proposed by a manually dispatched workflow; see docs/ORGANIZATION_DIRECTORY.md."
+
+          branch_exists=no; branch_matches=no; open_pr=no
+          if git ls-remote --exit-code --heads origin "$branch" >/dev/null 2>&1; then
+            branch_exists=yes
+            git fetch --no-tags origin "refs/heads/$branch:refs/remotes/origin/$branch"
+            branch_matches="$(node scripts/deploy/organization-live.mjs branch-matches --branch "origin/$branch" --head proposal-local)"
+          fi
+          if [ "$(gh pr list --head "$branch" --state open --json number --jq 'length')" != "0" ]; then open_pr=yes; fi
+
+          action="$(node scripts/deploy/organization-live.mjs plan \
+            --branch-exists "$branch_exists" --branch-matches "$branch_matches" --open-pr "$open_pr")"
+          echo "Plan: $action (branch exists: $branch_exists, matches: $branch_matches, open PR: $open_pr)" | tee -a "$GITHUB_STEP_SUMMARY"
+
+          title="feat: admit organization directory bundle ${REF:0:12}"
+          body="Manual propagation of the reviewed organization bundle at \`Pick-Your-AI/.github@$REF\` (merged pull request #$PR, review $REVIEW_ID). The importer verified the exact commit, the closed file inventory, the reviewed script hash, the privacy rules, and that the commit is an ancestor of \`.github\` main. Merging this is the website source-pin approval and deploys through the normal pipeline. Checks do not start automatically for a pull request opened with the workflow token: run \`ci-required\` with an authorized identity before merging. Publication time is the deployment readback, not the observation time."
+          create_pr() {
+            gh pr create --base main --head "$branch" --title "$title" --body "$body" || {
+              echo "Pull request creation failed. If this repository does not allow Actions to create pull requests, that is an owner gate; the branch is kept and a re-run will create only the pull request." | tee -a "$GITHUB_STEP_SUMMARY"
+              exit 1
+            }
+          }
+          case "$action" in
+            noop) ;;
+            create-pr) create_pr ;;
+            create-branch-and-pr)
+              # Never force: a concurrent writer makes this fail instead of being overwritten.
+              git push origin "proposal-local:refs/heads/$branch"
+              create_pr
+              ;;
+          esac
