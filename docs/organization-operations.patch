+// Reproducible checks for the /organization/ operations proposal: strict CSP, canonical-route byte
+// identity, and recovery/reuse of one proposal branch and PR. Run: node --test scripts/deploy/organization-live.test.mjs
+import assert from 'node:assert/strict';
+import { execFileSync } from 'node:child_process';
+import { mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import test from 'node:test';
+import {
+  branchMatches,
+  checkCanonicalRoute,
+  checkOrganizationCsp,
+  checkSiteCsp,
+  parsePolicies,
+  planProposal,
+  sha256,
+} from './organization-live.mjs';
+
+const ORG_CSP =
+  "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'";
+const SITE_CSP = ORG_CSP.replace("style-src 'self' 'unsafe-inline'", "style-src 'self'");
+const headers = (...policies) =>
+  ['HTTP/2 200', 'content-type: text/html', ...policies.map((p) => `Content-Security-Policy: ${p}`), ''].join('\r\n');
+
+test('CSP: the intended /organization/ policy passes', () => {
+  assert.deepEqual(checkOrganizationCsp(headers(ORG_CSP)), []);
+});
+
+test('CSP: extra script origins are refused (a substring match for script-src would accept them)', () => {
+  const widened = [
+    ORG_CSP.replace("script-src 'self'", "script-src 'self' https://evil.example"),
+    ORG_CSP.replace("script-src 'self'", "script-src 'self' 'unsafe-inline'"),
+    ORG_CSP.replace("script-src 'self'", "script-src 'self' 'unsafe-eval'"),
+    ORG_CSP.replace("script-src 'self'", "script-src 'self' *"),
+    ORG_CSP.replace("script-src 'self'", "script-src 'self' data:"),
+    ORG_CSP.replace("script-src 'self'", "script-src https://evil.example 'self'"),
+    ORG_CSP.replace("script-src 'self'", "script-src 'self' 'strict-dynamic'"),
+  ];
+  for (const csp of widened) {
+    const errors = checkOrganizationCsp(headers(csp));
+    assert.ok(errors.some((e) => /effective script-src must be exactly 'self'/.test(e)), csp);
+  }
+  // The previous check, grep "script-src 'self'" and no "unsafe", accepts the remote origin:
+  const substring = (csp) => csp.includes("script-src 'self'") && !/script-src[^;]*unsafe/.test(csp);
+  assert.equal(substring(widened[0]), true, 'the old substring check would have accepted this');
+});
+
+test('CSP: script-src-elem and script-src-attr may not override script-src', () => {
+  for (const extra of [
+    "script-src-elem 'self' https://evil.example",
+    "script-src-elem https://evil.example",
+    "script-src-elem 'unsafe-inline'",
+    "script-src-attr 'unsafe-inline'",
+    "script-src-attr 'self'",
+  ]) {
+    const errors = checkOrganizationCsp(headers(`${ORG_CSP}; ${extra}`));
+    assert.ok(errors.length > 0, extra);
+  }
+  assert.deepEqual(checkOrganizationCsp(headers(`${ORG_CSP}; script-src-attr 'none'`)), []);
+  assert.deepEqual(checkOrganizationCsp(headers(`${ORG_CSP}; script-src-elem 'self'`)), []);
+});
+
+test('CSP: default-src is the fallback, and every enforced policy is checked', () => {
+  const fallbackOk = "default-src 'self' 'unsafe-inline'";
+  // style 'self' 'unsafe-inline' via default-src would also open scripts: refused.
+  assert.ok(checkOrganizationCsp(headers(fallbackOk)).length > 0);
+  const noScriptSrc = ORG_CSP.replace("script-src 'self'; ", "").replace("default-src 'self'", "default-src 'self' https://cdn.example");
+  assert.ok(checkOrganizationCsp(headers(noScriptSrc)).length > 0);
+  // Two header lines, one widened: the intersection is enforced, but each must individually be safe.
+  const errors = checkOrganizationCsp(headers(ORG_CSP, ORG_CSP.replace("script-src 'self'", "script-src 'self' https://x.example")));
+  assert.ok(errors.some((e) => e.startsWith('CSP policy 2')));
+  assert.deepEqual(checkOrganizationCsp(headers(ORG_CSP, ORG_CSP)), []);
+  // A comma-separated pair in one header is two policies.
+  assert.equal(parsePolicies(headers(`${ORG_CSP}, ${SITE_CSP}`)).length, 2);
+  assert.ok(checkOrganizationCsp(headers(`${ORG_CSP}, ${SITE_CSP}`)).some((e) => /policy 2.*style-src/.test(e)));
+});
+
+test('CSP: the style exception must really be present, report-only is ignored, absence fails', () => {
+  assert.ok(checkOrganizationCsp(headers(SITE_CSP)).some((e) => /effective style-src/.test(e)));
+  assert.ok(
+    checkOrganizationCsp(headers(ORG_CSP.replace("style-src 'self' 'unsafe-inline'", "style-src 'self' 'unsafe-inline' https://fonts.example"))).some((e) => /style-src/.test(e)),
+  );
+  assert.ok(checkOrganizationCsp(headers(`${ORG_CSP}; style-src-elem 'self'`)).some((e) => /style-src-elem/.test(e)));
+  assert.deepEqual(checkOrganizationCsp(`HTTP/2 200\r\nContent-Security-Policy-Report-Only: ${ORG_CSP}\r\n`), ['no Content-Security-Policy header on /organization/']);
+  assert.deepEqual(checkOrganizationCsp('HTTP/2 200\r\n'), ['no Content-Security-Policy header on /organization/']);
+});
+
+test('CSP: the exception stays path-scoped (the rest of the site keeps style-src self)', () => {
+  assert.deepEqual(checkSiteCsp(headers(SITE_CSP)), []);
+  assert.ok(checkSiteCsp(headers(ORG_CSP)).some((e) => /style-src was loosened/.test(e)));
+  assert.ok(checkSiteCsp(headers(SITE_CSP.replace("script-src 'self'", "script-src 'self' https://x.example"))).length > 0);
+});
+
+test('CSP: element and attribute directives cannot add remote sources', () => {
+  assert.ok(checkOrganizationCsp(headers(`${ORG_CSP}; style-src-elem 'unsafe-inline' https://example.invalid`)).length);
+  assert.ok(checkOrganizationCsp(headers(`${ORG_CSP}; style-src-attr 'self' 'unsafe-inline' https://example.invalid`)).length);
+  for (const directive of ['script-src-elem', 'script-src-attr', 'style-src-elem', 'style-src-attr']) {
+    assert.ok(checkSiteCsp(headers(`${SITE_CSP}; ${directive} https://example.invalid`)).length, directive);
+  }
+  assert.deepEqual(checkOrganizationCsp(headers(`${ORG_CSP}; style-src-elem 'self' 'unsafe-inline'`)), []);
+});
+
+const INDEX = Buffer.from('<!doctype html><html lang="en"><title>Current organization</title><main id="directory"></main></html>\n');
+const pin = (index = INDEX) => ({
+  admitted: { files: [{ path: 'index.html', sha256: sha256(index), bytes: index.length }] },
+});
+
+test('canonical route: the actual /organization/ response must equal the pinned index.html', () => {
+  assert.deepEqual(checkCanonicalRoute(pin(), INDEX), []);
+  // A marker alone (id="directory") would accept all of these.
+  const stale = Buffer.from(INDEX.toString().replace('Current organization', 'Previous organization'));
+  const spa = Buffer.from('<!doctype html><html><div id="root"></div></html>');
+  for (const body of [stale, spa, Buffer.alloc(0), Buffer.concat([INDEX, Buffer.from('\n')])]) {
+    const errors = checkCanonicalRoute(pin(), body);
+    assert.equal(errors.length, 1);
+    assert.match(errors[0], /pinned index\.html/);
+  }
+});
+
+test('canonical route: host-injected content fails by design and is never stripped or ignored', () => {
+  const injected = Buffer.from(
+    INDEX.toString().replace('</html>', '<script>/* host monitoring */</script><script src="https://cdn.example/monitor.js"></script></html>'),
+  );
+  assert.ok(injected.toString().includes('id="directory"'), 'the marker is still present');
+  const errors = checkCanonicalRoute(pin(), injected);
+  assert.equal(errors.length, 1);
+  assert.match(errors[0], /host-injected content breaks byte identity by design/);
+  assert.deepEqual(checkCanonicalRoute({ admitted: null }, INDEX), ['no bundle is admitted in the pin']);
+});
+
+test('proposal plan: reuse one verified branch/PR, recover a partial run, never overwrite', () => {
+  const plan = (branchExists, branchMatches, openPr) => planProposal({ branchExists, branchMatches, openPr }).action;
+  assert.equal(plan(false, false, false), 'create-branch-and-pr');
+  // Pushed, then PR creation failed: a re-run creates only the PR.
+  assert.equal(plan(true, true, false), 'create-pr');
+  // Already proposed correctly: success, no duplicate.
+  assert.equal(plan(true, true, true), 'noop');
+  // Unrelated or divergent work is never overwritten.
+  assert.equal(plan(true, false, false), 'fail');
+  assert.equal(plan(true, false, true), 'fail');
+  assert.equal(plan(false, false, true), 'fail');
+});
+
+const env = { ...process.env, GIT_AUTHOR_NAME: 't', GIT_AUTHOR_EMAIL: 't@example.invalid', GIT_COMMITTER_NAME: 't', GIT_COMMITTER_EMAIL: 't@example.invalid' };
+const git = (cwd, ...args) => execFileSync('git', args, { cwd, env, stdio: ['ignore', 'pipe', 'pipe'] }).toString().trim();
+
+test('branch match: exactly one commit with identical bundle paths is the verified proposal', { timeout: 60_000 }, () => {
+  const repo = mkdtempSync(join(tmpdir(), 'pyai-ops-branch-'));
+  try {
+    git(repo, 'init', '-q', '-b', 'main');
+    writeFileSync(join(repo, 'a.txt'), 'base');
+    git(repo, 'add', '-A');
+    git(repo, 'commit', '-q', '-m', 'base');
+    git(repo, 'update-ref', 'refs/remotes/origin/main', 'HEAD');
+    const write = (content) => {
+      mkdirSync(join(repo, 'public/organization'), { recursive: true });
+      mkdirSync(join(repo, 'contracts/organization'), { recursive: true });
+      writeFileSync(join(repo, 'public/organization/index.html'), content);
+      writeFileSync(join(repo, 'contracts/organization/PIN.json'), `{"v":"${content}"}`);
+    };
+    const commit = (message) => {
+      git(repo, 'add', '-A');
+      git(repo, 'commit', '-q', '-m', message);
+    };
+    // The importer's result, committed locally (what the workflow compares against).
+    git(repo, 'switch', '-q', '-c', 'proposal-local');
+    write('v1');
+    commit('proposal');
+    const proposal = git(repo, 'rev-parse', 'HEAD');
+    const remote = (name, sha) => git(repo, 'update-ref', `refs/remotes/origin/${name}`, sha);
+
+    // Identical single-commit branch (earlier run pushed, then PR creation failed): matches.
+    remote('good', proposal);
+    assert.equal(branchMatches({ cwd: repo, branch: 'origin/good', head: 'proposal-local' }), true);
+
+    // Same bundle plus unrelated work in the SAME commit must also be rejected.
+    git(repo, 'switch', '-q', '-c', 'same-commit-extra', 'origin/main');
+    write('v1');
+    writeFileSync(join(repo, 'unrelated-in-same-commit.txt'), 'someone else');
+    commit('bundle with unrelated work');
+    remote('same-commit-extra', git(repo, 'rev-parse', 'HEAD'));
+    assert.equal(branchMatches({ cwd: repo, branch: 'origin/same-commit-extra', head: 'proposal-local' }), false);
+    git(repo, 'switch', '-q', 'proposal-local');
+
+    // Extra unrelated commit on top: not the verified proposal, must not be reused or overwritten.
+    git(repo, 'switch', '-q', '-c', 'extra');
+    writeFileSync(join(repo, 'unrelated.txt'), 'someone else');
+    commit('unrelated work');
+    remote('extra', git(repo, 'rev-parse', 'HEAD'));
+    assert.equal(branchMatches({ cwd: repo, branch: 'origin/extra', head: 'proposal-local' }), false);
+
+    // Different bundle content.
+    git(repo, 'switch', '-q', 'proposal-local');
+    git(repo, 'switch', '-q', '-c', 'other');
+    write('v2');
+    commit('different bundle');
+    remote('other', git(repo, 'rev-parse', 'HEAD'));
+    assert.equal(branchMatches({ cwd: repo, branch: 'origin/other', head: 'proposal-local' }), false);
+
+    // A branch with no commits above main.
+    remote('empty', git(repo, 'rev-parse', 'origin/main'));
+    assert.equal(branchMatches({ cwd: repo, branch: 'origin/empty', head: 'proposal-local' }), false);
+
+    // Missing ref.
+    assert.equal(branchMatches({ cwd: repo, branch: 'origin/missing', head: 'proposal-local' }), false);
+  } finally {
+    rmSync(repo, { recursive: true, force: true });
+  }
+});
+
+test('shell and workflow wiring: the strict checks are actually used, nothing weaker remains', () => {
+  const verify = readFileSync(new URL('./verify-live.sh', import.meta.url), 'utf8');
+  assert.match(verify, /organization-live\.mjs route "\$PIN" \/tmp\/pyai-org-index\.html/);
+  assert.match(verify, /organization-live\.mjs csp-organization/);
+  assert.match(verify, /organization-live\.mjs csp-site/);
+  assert.doesNotMatch(verify, /grep -q 'id="directory"'/, 'a marker must not decide the canonical route');
+  assert.doesNotMatch(verify, /script-src[^\n]*grep|grep[^\n]*script-src 'self'/, 'no substring CSP check');
+  const workflow = readFileSync(new URL('../../.github/workflows/organization-update-proposal.yml', import.meta.url), 'utf8');
+  assert.match(workflow, /ORGANIZATION_PROPOSAL_ENABLED == 'true'/);
+  assert.match(workflow, /MISSING OWNER GATES/);
+  assert.match(workflow, /contrib\/github-actions\/organization-/);
+  assert.doesNotMatch(workflow, /feat\/organization/);
+  assert.match(workflow, /organization-live\.mjs plan/);
+  assert.match(workflow, /organization-live\.mjs branch-matches/);
+  assert.doesNotMatch(workflow, /--force|push -f|--basis|owner-accepted/);
+  assert.doesNotMatch(workflow, /schedule:|pull_request_target|repository_dispatch/);
+});
diff --git a/scripts/deploy/verify-live.sh b/scripts/deploy/verify-live.sh
index dd06bb1..6fc2064 100644
--- a/scripts/deploy/verify-live.sh
+++ b/scripts/deploy/verify-live.sh
@@ -70,0 +71,63 @@ if [ "$wk" != "200" ] || ! grep -q 'id="root"' /tmp/pyai-wk; then ok "/.well-kno
+# 7. Organization directory (/organization/). The expected state comes from the pin of the release being
+#    verified: the deploy job's checkout is that commit; the rollback job passes the target release's
+#    pin in ORGANIZATION_PIN (set but empty = that release predates the integration).
+PIN="${ORGANIZATION_PIN-contracts/organization/PIN.json}"
+if [ -z "$PIN" ] || [ ! -f "$PIN" ]; then
+  echo "  --   no organization pin for this release; /organization/ not verified"
+else
+  org_files="$(python3 - "$PIN" <<'PY'
+import json, sys
+admitted = json.load(open(sys.argv[1]))["admitted"]
+if admitted:
+    for f in admitted["files"]:
+        print(f["path"], f["sha256"])
+PY
+)" || { bad "organization pin is unreadable"; org_files=""; }
+  if [ -n "$org_files" ]; then
+    ohdr="$(c -o /tmp/pyai-org-index.html -D - --max-time 15 "$BASE/organization/?v=$SHA")"
+    ocode="$(printf '%s' "$ohdr" | head -1 | awk '{print $2}')"
+    [ "$ocode" = "200" ] && ok "GET /organization/ → 200" || bad "GET /organization/ → $ocode"
+    grep -qi '^content-type: text/html' <<<"$ohdr" && ok "/organization/ is text/html" || bad "/organization/ content-type"
+    grep -qi '^cache-control:.*no-cache' <<<"$ohdr" && ok "/organization/ Cache-Control no-cache" || bad "/organization/ missing Cache-Control no-cache"
+    # The ACTUAL canonical route must be byte-identical to the pinned index.html. A marker is not enough, and
+    # nothing may be stripped or ignored: host-injected content makes this fail until operations opts out.
+    if out="$(node scripts/deploy/organization-live.mjs route "$PIN" /tmp/pyai-org-index.html 2>&1)"; then ok "GET /organization/ is byte-identical to the pinned index.html"; else bad "$out"; fi
+    printf '%s' "$ohdr" > /tmp/pyai-org-headers
+    printf '%s' "$hdr" > /tmp/pyai-root-headers
+    if out="$(node scripts/deploy/organization-live.mjs csp-organization /tmp/pyai-org-headers 2>&1)"; then ok "/organization/ CSP: script-src is 'self' only in every policy; inline styles allowed"; else bad "$out"; fi
+    if out="$(node scripts/deploy/organization-live.mjs csp-site /tmp/pyai-root-headers 2>&1)"; then ok "/ keeps style-src 'self' (exception is path-scoped)"; else bad "$out"; fi
+    oloc="$(c -o /dev/null -w '%{http_code} %{redirect_url}' --max-time 15 "$BASE/organization")"
+    [[ "$oloc" == "301 $BASE/organization/" ]] && ok "/organization → /organization/ ($oloc)" || bad "/organization redirect: $oloc"
+    # Every file in the complete bundle (README.md included): HTTP 200, the right MIME type, exactly the
+    # pinned bytes (not the SPA fallback).
+    while read -r name want; do
+      [ -n "$name" ] || continue
+      fhdr="$(c -o /tmp/pyai-org-file -D - --max-time 20 "$BASE/organization/$name?v=$SHA")"
+      fcode="$(printf '%s' "$fhdr" | head -1 | awk '{print $2}')"
+      got="$(python3 -c 'import hashlib,sys; print(hashlib.sha256(open(sys.argv[1],"rb").read()).hexdigest())' /tmp/pyai-org-file)"
+      case "$name" in
+        *.html) want_type='text/html' ;;
+        *.js) want_type='(text|application)/javascript' ;;
+        *.json) want_type='application/json' ;;
+        *.svg) want_type='image/svg\+xml' ;;
+        *.png) want_type='image/png' ;;
+        *.mmd) want_type='text/plain' ;;
+        *.md) want_type='text/(markdown|plain)' ;;
+        *) want_type='' ;;
+      esac
+      if [ "$fcode" = "200" ] && [ "$got" = "$want" ] && grep -Eqi "^content-type: *$want_type" <<<"$fhdr"; then
+        ok "/organization/$name matches the pin"
+      else
+        bad "/organization/$name (HTTP $fcode, bytes match pin: $([ "$got" = "$want" ] && echo yes || echo no), type wanted: ${want_type:-any})"
+      fi
+    done <<<"$org_files"
+    mcode="$(c -o /dev/null -w '%{http_code}' --max-time 15 "$BASE/organization/does-not-exist-$SHA.svg")"
+    [ "$mcode" = "404" ] && ok "missing /organization file → 404" || bad "missing /organization file → $mcode (expected 404)"
+  else
+    pcode="$(c -o /tmp/pyai-org-pending.html -w '%{http_code}' --max-time 15 "$BASE/organization/")"
+    if [ "$pcode" = "200" ] && grep -q 'id="root"' /tmp/pyai-org-pending.html; then ok "/organization/ → pending SPA page (no bundle admitted)"; else bad "/organization/ → $pcode (expected the pending SPA page)"; fi
+    dcode="$(c -o /dev/null -w '%{http_code}' --max-time 15 "$BASE/organization/directory.js")"
+    [ "$dcode" = "404" ] && ok "no organization files served while none is admitted" || bad "/organization/directory.js → $dcode (expected 404)"
+  fi
+fi
