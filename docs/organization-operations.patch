diff --git b/scripts/deploy/organization-live.mjs b/scripts/deploy/organization-live.mjs
new file mode 100644
index 0000000..7073a50
--- /dev/null
+++ b/scripts/deploy/organization-live.mjs
@@ -0,0 +1,189 @@
+#!/usr/bin/env node
+// Checks used by the operations proposal for the /organization/ directory (docs/ORGANIZATION_DIRECTORY.md).
+// Pure Node, no dependencies, so verify-live.sh and the proposal workflow can call it and the tests can
+// reproduce each failure mode.
+//
+//   organization-live.mjs csp-organization <raw-response-headers>   strict /organization/ CSP
+//   organization-live.mjs csp-site <raw-response-headers>           the rest of the site stays strict
+//   organization-live.mjs route <PIN.json> <response-body-file>     canonical route == pinned index.html
+//   organization-live.mjs plan --branch-exists yes|no --branch-matches yes|no --open-pr yes|no
+//   organization-live.mjs branch-matches --branch <ref> [--base origin/main] [--head HEAD]
+import { execFileSync } from 'node:child_process';
+import { createHash } from 'node:crypto';
+import { readFileSync } from 'node:fs';
+import { fileURLToPath, pathToFileURL } from 'node:url';
+
+export const sha256 = (data) => createHash('sha256').update(data).digest('hex');
+
+const SELF = "'self'";
+const same = (tokens, expected) =>
+  Array.isArray(tokens) &&
+  tokens.length === expected.length &&
+  [...tokens].sort().join(' ') === [...expected].sort().join(' ');
+
+/** Parses `Content-Security-Policy` header lines from raw `curl -D` output; report-only lines are ignored. */
+export function parsePolicies(rawHeaders) {
+  const policies = [];
+  for (const line of String(rawHeaders).split(/\r?\n/)) {
+    const m = /^content-security-policy:\s*(.*)$/i.exec(line);
+    if (!m) continue;
+    // One header may carry several comma-separated policies; every one of them is enforced.
+    for (const policy of m[1].split(',')) {
+      const directives = new Map();
+      for (const part of policy.split(';')) {
+        const [name, ...tokens] = part.trim().split(/\s+/);
+        if (!name) continue;
+        // The first occurrence of a directive wins (CSP3).
+        if (!directives.has(name.toLowerCase())) directives.set(name.toLowerCase(), tokens);
+      }
+      if (directives.size) policies.push(directives);
+    }
+  }
+  return policies;
+}
+
+const show = (tokens) => (tokens === undefined ? '(absent)' : `[${tokens.join(' ')}]`);
+
+/**
+ * /organization/ may relax only style-src (the canonical page has an inline <style> block). Scripts must
+ * stay 'self' in EVERY enforced policy, including through script-src-elem / script-src-attr and the
+ * default-src fallback; a substring match for "script-src 'self'" would also accept extra origins.
+ */
+export function checkOrganizationCsp(rawHeaders) {
+  const policies = parsePolicies(rawHeaders);
+  if (!policies.length) return ['no Content-Security-Policy header on /organization/'];
+  const errors = [];
+  policies.forEach((p, i) => {
+    const at = `CSP policy ${i + 1}`;
+    const script = p.get('script-src') ?? p.get('default-src');
+    if (!same(script, [SELF]))
+      errors.push(`${at}: effective script-src must be exactly 'self', got ${show(script)}`);
+    const elem = p.get('script-src-elem');
+    if (elem !== undefined && !same(elem, [SELF]))
+      errors.push(`${at}: script-src-elem may not widen scripts, got ${show(elem)}`);
+    const attr = p.get('script-src-attr');
+    if (attr !== undefined && !same(attr, ["'none'"]))
+      errors.push(`${at}: script-src-attr must be absent or 'none', got ${show(attr)}`);
+    const style = p.get('style-src') ?? p.get('default-src');
+    if (!same(style, [SELF, "'unsafe-inline'"]))
+      errors.push(`${at}: effective style-src must be exactly 'self' 'unsafe-inline', got ${show(style)}`);
+    for (const name of ['style-src-elem', 'style-src-attr']) {
+      const v = p.get(name);
+      if (v !== undefined && !same(v, [SELF, "'unsafe-inline'"]))
+        errors.push(`${at}: ${name} must be exactly 'self' 'unsafe-inline', got ${show(v)}`);
+    }
+  });
+  return errors;
+}
+
+/** The exception is path-scoped: the rest of the site keeps style-src 'self' with no inline relaxation. */
+export function checkSiteCsp(rawHeaders) {
+  const policies = parsePolicies(rawHeaders);
+  if (!policies.length) return ['no Content-Security-Policy header on /'];
+  const errors = [];
+  policies.forEach((p, i) => {
+    const style = p.get('style-src') ?? p.get('default-src');
+    if (!same(style, [SELF])) errors.push(`CSP policy ${i + 1} on /: style-src was loosened, got ${show(style)}`);
+    const script = p.get('script-src') ?? p.get('default-src');
+    if (!same(script, [SELF])) errors.push(`CSP policy ${i + 1} on /: script-src must be 'self', got ${show(script)}`);
+    for (const [name, expected] of [
+      ['script-src-elem', [SELF]], ['script-src-attr', ["'none'"]],
+      ['style-src-elem', [SELF]], ['style-src-attr', ["'none'"]],
+    ]) {
+      const value = p.get(name);
+      if (value !== undefined && !same(value, expected))
+        errors.push(`CSP policy ${i + 1} on /: ${name} has unexpected sources ${show(value)}`);
+    }
+  });
+  return errors;
+}
+
+/**
+ * The actual canonical /organization/ response must be byte-identical to the pinned index.html. A marker
+ * such as id="directory" accepts a stale or wrong canonical route; so does ignoring injected content.
+ * Do not "fix" a mismatch by stripping or ignoring anything in the body.
+ */
+export function checkCanonicalRoute(pin, body) {
+  const admitted = pin?.admitted;
+  if (!admitted) return ['no bundle is admitted in the pin'];
+  const entry = admitted.files.find((f) => f.path === 'index.html');
+  if (!entry) return ['the pin has no index.html'];
+  const got = sha256(body);
+  if (got === entry.sha256 && body.length === entry.bytes) return [];
+  return [
+    `GET /organization/ is ${body.length} bytes, sha256 ${got}; the pinned index.html is ${entry.bytes} bytes, sha256 ${entry.sha256}. ` +
+      'The route is stale, wrong, or the host altered the HTML (host-injected content breaks byte identity by design; see docs/ORGANIZATION_DIRECTORY.md, hosting gate).',
+  ];
+}
+
+/**
+ * Reconciles a proposal run with what already exists, so a re-run recovers instead of failing or
+ * overwriting: one verified branch, one PR. Unrelated or divergent work is never touched.
+ */
+export function planProposal({ branchExists, branchMatches, openPr }) {
+  if (openPr && branchExists && branchMatches) return { action: 'noop', reason: 'the correct pull request is already open' };
+  if (openPr) return { action: 'fail', reason: 'an open pull request exists but its branch is missing or differs from the verified proposal; reconcile it manually' };
+  if (branchExists && branchMatches) return { action: 'create-pr', reason: 'the verified branch exists without a pull request (earlier run failed after pushing); create only the pull request' };
+  if (branchExists) return { action: 'fail', reason: 'the branch exists with unrelated or different content; it is never overwritten' };
+  return { action: 'create-branch-and-pr', reason: 'nothing exists yet' };
+}
+
+const git = (args, cwd) => execFileSync('git', args, { cwd, stdio: ['ignore', 'pipe', 'pipe'] }).toString().trim();
+
+/** True when `branch` is exactly one commit above `base` and its bundle paths equal `head`'s. */
+export function branchMatches({ cwd = '.', branch, base = 'origin/main', head = 'HEAD', paths = ['public/organization', 'contracts/organization'] }) {
+  try {
+    git(['merge-base', '--is-ancestor', base, branch], cwd);
+    if (git(['rev-list', '--count', `${base}..${branch}`], cwd) !== '1') return false;
+    const changed = git(['diff', '--name-only', `${base}...${branch}`], cwd).split('\n').filter(Boolean);
+    if (changed.some((name) => !paths.some((allowed) => name === allowed || name.startsWith(`${allowed}/`)))) return false;
+    git(['diff', '--quiet', head, branch, '--', ...paths], cwd);
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+function option(args, name) {
+  const i = args.indexOf(name);
+  return i < 0 ? undefined : args[i + 1];
+}
+const yes = (v) => v === 'yes';
+
+function main(argv) {
+  const [cmd, ...args] = argv;
+  let errors = [];
+  if (cmd === 'csp-organization') errors = checkOrganizationCsp(readFileSync(args[0], 'utf8'));
+  else if (cmd === 'csp-site') errors = checkSiteCsp(readFileSync(args[0], 'utf8'));
+  else if (cmd === 'route') errors = checkCanonicalRoute(JSON.parse(readFileSync(args[0], 'utf8')), readFileSync(args[1]));
+  else if (cmd === 'plan') {
+    const plan = planProposal({
+      branchExists: yes(option(args, '--branch-exists')),
+      branchMatches: yes(option(args, '--branch-matches')),
+      openPr: yes(option(args, '--open-pr')),
+    });
+    if (plan.action === 'fail') errors = [plan.reason];
+    else {
+      console.error(plan.reason);
+      console.log(plan.action);
+      return 0;
+    }
+  } else if (cmd === 'branch-matches') {
+    const ok = branchMatches({ branch: option(args, '--branch'), base: option(args, '--base') ?? 'origin/main', head: option(args, '--head') ?? 'HEAD' });
+    console.log(ok ? 'yes' : 'no');
+    return 0;
+  } else {
+    console.error('usage: organization-live.mjs csp-organization|csp-site|route|plan|branch-matches ...');
+    return 2;
+  }
+  if (errors.length) {
+    console.error(errors.join('\n'));
+    return 1;
+  }
+  console.log(`${cmd}: ok`);
+  return 0;
+}
+
+if (process.argv[1] && import.meta.url === pathToFileURL(fileURLToPath(pathToFileURL(process.argv[1]))).href) {
+  process.exitCode = main(process.argv.slice(2));
+}
